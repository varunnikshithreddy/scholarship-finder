# ==============================================================================
# AI-Powered Scholarship Finder Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Google Gemini AI Integration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Transactional Notifications & Email
EMAIL_PROVIDER_API_KEY=your-email-api-key
EMAIL_FROM="Scholarship Finder <noreply@scholarshipfinder.org>"
SCHEDULER_SECRET=your-scheduler-cron-secret-key

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=15

# Localization & Logging
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata

# Client-side exposed variables (prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
