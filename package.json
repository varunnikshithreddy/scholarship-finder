{
  "name": "scholarship-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade AI-Powered Scholarship Finder Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=shared && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start": "node server/dist/server.js",
    "start:server": "node server/dist/server.js",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "migrate": "node scripts/apply-migration.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
